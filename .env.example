# Bot JADID besaz via @BotFather (bot e XT ro reuse nakon — polling conflict)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# Neon Postgres (pooled, -pooler). Khali = SQLite local
DATABASE_URL=
# Symbol aval (har format: BTC, btc_usdt, SAGAUSDT)
SCAN_SYMBOL=BTCUSDT
# Haman default haye XT
TIMEFRAMES=1m,3m,5m,15m
MIN_CONFIDENCE=80
TF_MIN_CONFIDENCE=70
MIN_AGREEING_STRATEGIES=2
COOLDOWN_MINUTES=15
SCAN_INTERVAL_SEC=60
REPORT_INTERVAL_SEC=0
# --- LLM (mesle XT, optional — nabashe deterministic kar mikone) ---
AI_PROVIDER=auto
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# ANTHROPIC_API_KEY=
AGENT_LLM_CONFIRM=true
